PORT=3000

# Required to store scan results.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SIGNALS_TABLE=stock_signals

# Optional. Defaults are tuned for public API limits.
SCAN_LIMIT=250
QUOTE_BATCH_SIZE=80
QUOTE_DELAY_MS=350
DATA_REFRESH_MS=30000
BACKGROUND_MARKET_PAGES=3

# Optional: Zerodha Kite Connect for Indian live quotes.
# Requires a Kite Connect app and a valid daily access token.
KITE_API_KEY=
KITE_ACCESS_TOKEN=
